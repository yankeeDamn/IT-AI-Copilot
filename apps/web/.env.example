# Next.js web uses dedicated Prisma schema "itsm" on the existing PostgreSQL cluster.
ITSM_DATABASE_URL=postgresql://copilot:local-password@127.0.0.1:5432/copilot?schema=itsm
AUTH_SECRET=generate-at-least-32-random-bytes
AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# No Azure subscription, model key or SSO credentials required to build the UI.
