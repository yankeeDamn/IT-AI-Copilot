// IT-AI-Copilot ITSM schema. Prisma owns "itsm"; Python/Alembic owns "public".
// Prisma ORM 6.19.0. No implicit tenant trust: scope every query by organizationId.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ITSM_DATABASE_URL")
  schemas  = ["itsm"]
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  accounts              Account[]
  sessions              Session[]
  memberships           Membership[]
  ticketsRequested      Ticket[] @relation("TicketRequester")
  ticketsAssigned       Ticket[] @relation("TicketAssignee")
  comments              TicketComment[]
  uploadedAttachments   TicketAttachment[]
  ticketHistory         TicketHistory[]
  assetAssignments      AssetAssignment[]
  writtenArticles       KnowledgeArticle[]
  conversations         AIConversation[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  automationRequested   AutomationApproval[] @relation("AutomationRequestedBy")
  automationReviewed    AutomationApproval[] @relation("AutomationReviewedBy")
  @@index([deletedAt])
  @@schema("itsm")
}

model Account {
  userId            String @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
  @@schema("itsm")
}

model Session {
  sessionToken String @unique
  userId       String @db.Uuid
  expires      DateTime
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@schema("itsm")
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime
  @@unique([identifier, token])
  @@schema("itsm")
}

model Organization {
  id                 String @id @default(uuid()) @db.Uuid
  slug               String @unique @db.VarChar(80)
  name               String @db.VarChar(200)
  nextTicketNumber   Int @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?
  memberships        Membership[]
  roles              Role[]
  departments        Department[]
  ticketCategories   TicketCategory[]
  tickets            Ticket[]
  slaPolicies        SLAPolicy[]
  assets             Asset[]
  knowledgeCategories KnowledgeCategory[]
  knowledgeArticles  KnowledgeArticle[]
  knowledgeChunks    KnowledgeChunk[]
  conversations      AIConversation[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  settings           SystemSetting[]
  integrations       Integration[]
  monitoringAlerts   MonitoringAlert[]
  reports            Report[]
  automationApprovals AutomationApproval[]
  @@index([deletedAt])
  @@schema("itsm")
}

model Role {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  key            String @db.VarChar(70)
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        Membership[]
  permissions    RolePermission[]
  @@unique([organizationId, key])
  @@schema("itsm")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(90)
  description String?
  roles       RolePermission[]
  @@schema("itsm")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@schema("itsm")
}

model Membership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  roleId         String @db.Uuid
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role @relation(fields: [roleId], references: [id])
  @@unique([organizationId, userId])
  @@index([userId, active])
  @@schema("itsm")
}

model Department {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String @db.VarChar(140)
  code           String @db.VarChar(40)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  tickets        Ticket[]
  assets         Asset[]
  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@schema("itsm")
}

model TicketCategory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String
  key            String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tickets        Ticket[]
  @@unique([organizationId, key])
  @@schema("itsm")
}

model Ticket {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  number         Int
  title          String @db.VarChar(200)
  description    String @db.Text
  priority       String @default("MEDIUM") @db.VarChar(16)
  status         String @default("OPEN") @db.VarChar(30)
  categoryId     String? @db.Uuid
  departmentId   String? @db.Uuid
  requesterId    String @db.Uuid
  assigneeId     String? @db.Uuid
  assetId        String? @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  resolvedAt     DateTime?
  closedAt       DateTime?
  deletedAt      DateTime?
  createdById    String? @db.Uuid
  updatedById    String? @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  category       TicketCategory? @relation(fields: [categoryId], references: [id])
  department     Department? @relation(fields: [departmentId], references: [id])
  requester      User @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee       User? @relation("TicketAssignee", fields: [assigneeId], references: [id])
  asset          Asset? @relation(fields: [assetId], references: [id])
  comments       TicketComment[]
  attachments    TicketAttachment[]
  history        TicketHistory[]
  sla            TicketSLA?
  conversations  AIConversation[]
  alerts         MonitoringAlert[]
  approvals      AutomationApproval[]
  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, priority, createdAt])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, requesterId, createdAt])
  @@index([organizationId, deletedAt])
  @@schema("itsm")
}

model TicketComment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId       String @db.Uuid
  authorId       String @db.Uuid
  body           String @db.Text
  internal       Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  ticket         Ticket @relation(fields: [ticketId], references: [id])
  author         User @relation(fields: [authorId], references: [id])
  @@index([organizationId, ticketId, createdAt])
  @@schema("itsm")
}

model TicketAttachment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId       String @db.Uuid
  uploadedById   String @db.Uuid
  filename       String
  blobKey        String @unique
  mimeType       String
  bytes          Int
  scanStatus     String @default("PENDING")
  checksum       String
  createdAt      DateTime @default(now())
  deletedAt      DateTime?
  ticket         Ticket @relation(fields: [ticketId], references: [id])
  uploadedBy     User @relation(fields: [uploadedById], references: [id])
  @@index([organizationId, ticketId])
  @@schema("itsm")
}

model TicketHistory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId       String @db.Uuid
  actorId        String? @db.Uuid
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())
  ticket         Ticket @relation(fields: [ticketId], references: [id])
  actor          User? @relation(fields: [actorId], references: [id])
  @@index([organizationId, ticketId, createdAt])
  @@schema("itsm")
}

model SLAPolicy {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  name            String
  priority        String
  responseMinutes Int
  resolveMinutes  Int
  active          Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  ticketSLAs      TicketSLA[]
  @@index([organizationId, priority, active])
  @@schema("itsm")
}

model TicketSLA {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId       String @unique @db.Uuid
  policyId       String @db.Uuid
  responseDueAt  DateTime
  resolveDueAt   DateTime
  respondedAt    DateTime?
  breachedAt     DateTime?
  pausedAt       DateTime?
  ticket         Ticket @relation(fields: [ticketId], references: [id])
  policy         SLAPolicy @relation(fields: [policyId], references: [id])
  @@index([organizationId, resolveDueAt, breachedAt])
  @@schema("itsm")
}

model Asset {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  departmentId   String? @db.Uuid
  type           String
  name           String
  serialNumber   String?
  assetTag       String
  vendor         String?
  model          String?
  location       String?
  purchaseDate   DateTime?
  warrantyEndsAt DateTime?
  status         String @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  department     Department? @relation(fields: [departmentId], references: [id])
  assignments    AssetAssignment[]
  maintenance    AssetMaintenance[]
  tickets        Ticket[]
  @@unique([organizationId, assetTag])
  @@unique([organizationId, serialNumber])
  @@index([organizationId, status, deletedAt])
  @@schema("itsm")
}

model AssetAssignment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  assetId        String @db.Uuid
  userId         String @db.Uuid
  assignedAt     DateTime @default(now())
  returnedAt     DateTime?
  asset          Asset @relation(fields: [assetId], references: [id])
  user           User @relation(fields: [userId], references: [id])
  @@index([organizationId, assetId, returnedAt])
  @@schema("itsm")
}

model AssetMaintenance {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  assetId        String @db.Uuid
  dueAt          DateTime
  completedAt    DateTime?
  notes          String? @db.Text
  createdAt      DateTime @default(now())
  asset          Asset @relation(fields: [assetId], references: [id])
  @@index([organizationId, dueAt])
  @@schema("itsm")
}

model KnowledgeCategory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String
  slug           String
  organization   Organization @relation(fields: [organizationId], references: [id])
  articles       KnowledgeArticle[]
  @@unique([organizationId, slug])
  @@schema("itsm")
}

model KnowledgeArticle {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  categoryId     String? @db.Uuid
  authorId       String @db.Uuid
  title          String
  slug           String
  body           String @db.Text
  status         String @default("DRAFT")
  version        Int @default(1)
  tags           String[]
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  category       KnowledgeCategory? @relation(fields: [categoryId], references: [id])
  author         User @relation(fields: [authorId], references: [id])
  revisions      KnowledgeRevision[]
  chunks         KnowledgeChunk[]
  @@unique([organizationId, slug])
  @@index([organizationId, status, updatedAt])
  @@schema("itsm")
}

model KnowledgeRevision {
  id             String @id @default(uuid()) @db.Uuid
  articleId      String @db.Uuid
  organizationId String @db.Uuid
  version        Int
  title          String
  body           String @db.Text
  editorId       String @db.Uuid
  createdAt      DateTime @default(now())
  article        KnowledgeArticle @relation(fields: [articleId], references: [id])
  @@unique([articleId, version])
  @@index([organizationId, createdAt])
  @@schema("itsm")
}

model KnowledgeChunk {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  articleId      String @db.Uuid
  ordinal        Int
  content        String @db.Text
  checksum       String
  acl            Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  article        KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  embedding      KnowledgeEmbedding?
  @@unique([articleId, ordinal])
  @@index([organizationId, articleId])
  @@schema("itsm")
}

model KnowledgeEmbedding {
  id             String @id @default(uuid()) @db.Uuid
  chunkId        String @unique @db.Uuid
  model          String
  dimensions     Int
  embedding      Unsupported("vector(1536)")?
  indexedAt      DateTime @default(now())
  chunk          KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  @@schema("itsm")
}

model AIConversation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  ticketId       String? @db.Uuid
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User @relation(fields: [userId], references: [id])
  ticket         Ticket? @relation(fields: [ticketId], references: [id])
  responses      AIResponse[]
  @@index([organizationId, userId, createdAt])
  @@schema("itsm")
}

model AIResponse {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  role           String
  content        String @db.Text
  model          String?
  tokenCount     Int?
  citations      Json?
  createdAt      DateTime @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@schema("itsm")
}

model Notification {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  type           String
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User @relation(fields: [userId], references: [id])
  @@index([organizationId, userId, readAt, createdAt])
  @@schema("itsm")
}

model AuditLog {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  actorId        String? @db.Uuid
  action         String
  entityType     String
  entityId       String
  outcome        String
  requestId      String?
  metadata       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User? @relation(fields: [actorId], references: [id])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@schema("itsm")
}

model SystemSetting {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  key            String
  value          Json
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  @@unique([organizationId, key])
  @@schema("itsm")
}

model Integration {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  provider       String
  name           String
  secretRef      String?
  enabled        Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  alerts         MonitoringAlert[]
  @@index([organizationId, provider])
  @@schema("itsm")
}

model MonitoringAlert {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  integrationId  String? @db.Uuid
  ticketId       String? @db.Uuid
  fingerprint    String
  title          String
  severity       String
  status         String @default("OPEN")
  details        Json?
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  integration    Integration? @relation(fields: [integrationId], references: [id])
  ticket         Ticket? @relation(fields: [ticketId], references: [id])
  @@index([organizationId, status, severity, createdAt])
  @@unique([organizationId, fingerprint])
  @@schema("itsm")
}

model Report {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String
  type           String
  filters        Json?
  storageKey     String?
  status         String @default("QUEUED")
  requestedAt    DateTime @default(now())
  completedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  @@index([organizationId, requestedAt])
  @@schema("itsm")
}

model AutomationApproval {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId       String @db.Uuid
  playbook       String
  status         String @default("PENDING")
  requestedById  String @db.Uuid
  reviewedById   String? @db.Uuid
  requestedAt    DateTime @default(now())
  reviewedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  ticket         Ticket @relation(fields: [ticketId], references: [id])
  requestedBy    User @relation("AutomationRequestedBy", fields: [requestedById], references: [id])
  reviewedBy     User? @relation("AutomationReviewedBy", fields: [reviewedById], references: [id])
  @@index([organizationId, status, requestedAt])
  @@schema("itsm")
}
