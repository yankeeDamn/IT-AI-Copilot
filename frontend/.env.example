# Server-only; never prefix secrets with NEXT_PUBLIC_
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false
OIDC_ISSUER=https://your-identity-provider.example/tenant
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
# Include API scope/audience required by the Python OIDC_AUDIENCE config.
OIDC_SCOPES=openid profile email api://it-ai-copilot/access_as_user
# Prefer a private internal address accessible from the Next.js server.
COPILOT_API_BASE_URL=http://127.0.0.1:8000
